{
  "manifest_version": 3,
  "name": "ChatGPT Tab Extension Proxy",
  "version": "1.0",
  "description": "Bridges Surelock Homes AI agent with ChatGPT. Shows connection status for the ChatGPT tab and proxy server.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "*://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Bridge"
  }
}
